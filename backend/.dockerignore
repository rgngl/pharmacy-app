# Keep the build context small and free of host artifacts. Everything listed
# here is either regenerated by the Dockerfile itself or unrelated to the image.

# VCS / editor noise
.git
.gitignore
.idea
.vscode

# Mix build artifacts — rebuilt from scratch inside the image
_build
deps

# Language-server caches
.elixir_ls

# Tests are not part of the prod release build
test

# Crash dumps from local runs
erl_crash.dump

# Docs / local notes — not needed in the image
README.md
