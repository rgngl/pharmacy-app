<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pharmacy Finder</title>
    <.stylesheet />
  </head>
  <body>
    <div class="page">
      <header class="page-head">
        <div class="page-head-inner">
          <div class="head-row">
            <span class="head-icon" aria-hidden="true">+</span>
            <div>
              <h1>Find a pharmacy</h1>
              <p class="sub">Nearby locations, live opening hours & directions</p>
            </div>
          </div>

          <form method="get" action="/" class="search-row" id="search-form">
            <div class="search-box">
              <.icon name="pin" size={18} />
              <label class="hidden" for="q">Address</label>
              <input
                type="text"
                id="q"
                name="q"
                value={@submitted["q"] ||
                  if(is_binary(@submitted["lat"]) and @submitted["lat"] != "" and
                       is_binary(@submitted["lng"]) and @submitted["lng"] != "",
                     do: "#{@submitted["lat"]}, #{@submitted["lng"]}",
                     else: "")}
                placeholder="Enter an address"
                autocomplete="street-address"
              />
              <%= if is_binary(@submitted["lat"]) and @submitted["lat"] != "" and
                    is_binary(@submitted["lng"]) and @submitted["lng"] != "" do %>
                <input type="hidden" name="lat" id="hidden-lat" value={@submitted["lat"]} />
                <input type="hidden" name="lng" id="hidden-lng" value={@submitted["lng"]} />
              <% end %>
            </div>
            <button type="button" class="btn btn-outline" id="use-location">
              <.icon name="locate" />
              Use my location
            </button>
          </form>

          <%= if (is_binary(@submitted["lat"]) and @submitted["lat"] != "" and
                is_binary(@submitted["lng"]) and @submitted["lng"] != "") or
                (is_binary(@submitted["q"]) and @submitted["q"] != "") do %>
            <% base =
              if is_binary(@submitted["q"]) and @submitted["q"] != "" do
                %{"q" => @submitted["q"]}
              else
                %{"lat" => @submitted["lat"] || "", "lng" => @submitted["lng"] || ""}
              end %>
            <div class="filter-row">
              <span class="radius-label">Radius:</span>
              <%= for {label, m} <- [{"500 m", 500}, {"1 km", 1000}, {"2 km", 2000}, {"5 km", 5000}] do %>
                <.chip
                  label={label}
                  href={"/?" <> URI.encode_query(Map.put(base, "radius_m", m))}
                  active={PharmacyAppWeb.PageHTML.active_radius?(@submitted, m)}
                />
              <% end %>
              <%= if @searched and @pharmacies != [] do %>
                <span class="count">
                  Showing <strong>{length(@pharmacies)}</strong> pharmacies within {PharmacyAppWeb.PageHTML.radius_text(@submitted)}
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      </header>

      <main>
        <div id="geo-status" class="status hidden">
          <span class="spinner hidden" aria-hidden="true"></span>
          <span id="geo-status-text">Detecting your location…</span>
          <button type="button" class="retry hidden" id="geo-retry">Retry</button>
        </div>

        <%= if assigns[:banner] do %>
          <div class="banner" role="alert">{@banner}</div>
        <% end %>

        <%= if @errors != [] do %>
          <ul class="errors" role="alert">
            <%= for issue <- @errors do %>
              <li>{issue}</li>
            <% end %>
          </ul>
        <% end %>

        <%= if assigns[:no_params] do %>
          <div class="empty">
            Enter an address above, or use your location, to find nearby pharmacies.
          </div>
        <% else %>
          <%= if @searched do %>
            <%= if @pharmacies == [] do %>
              <div class="empty">
                No pharmacies found within {PharmacyAppWeb.PageHTML.radius_text(@submitted)}.
              </div>
            <% else %>
              <%= for p <- @pharmacies do %>
                <.pharmacy_card pharmacy={p} />
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </main>
    </div>

    <script>
      (function () {
        var status = document.getElementById("geo-status");
        var spinner = status.querySelector(".spinner");
        var statusText = document.getElementById("geo-status-text");
        var retryBtn = document.getElementById("geo-retry");
        var form = document.getElementById("search-form");
        var input = document.getElementById("q");
        var hiddenLat = document.getElementById("hidden-lat");
        var hiddenLng = document.getElementById("hidden-lng");

        function params() {
          return new URLSearchParams(window.location.search);
        }

        function showLoading() {
          status.classList.remove("hidden", "error");
          spinner.classList.remove("hidden");
          retryBtn.classList.add("hidden");
          statusText.textContent = "Detecting your location…";
        }

        function showError(message) {
          status.classList.add("error");
          status.classList.remove("hidden");
          spinner.classList.add("hidden");
          retryBtn.classList.remove("hidden");
          statusText.textContent = message;
        }

        function navigate(lat, lng) {
          var next = new URLSearchParams(window.location.search);
          next.set("lat", lat);
          next.set("lng", lng);
          // Explicit coordinates win over q on the server; keep the URL honest.
          next.delete("q");
          window.location.replace(
            window.location.pathname + "?" + next.toString()
          );
        }

        function locate() {
          if (!navigator.geolocation) {
            showError("Location detection requires HTTPS. Open this page over HTTPS, or pass ?lat=&lng= in the URL.");
            return;
          }
          showLoading();
          navigator.geolocation.getCurrentPosition(
            function (pos) {
              navigate(pos.coords.latitude.toFixed(6), pos.coords.longitude.toFixed(6));
            },
            function (err) {
              var messages = {
                1: "Location permission denied. Allow location access and retry.",
                2: "Location unavailable.",
                3: "Location request timed out."
              };
              showError(messages[err.code] || "Location unavailable.");
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
          );
        }

        retryBtn.addEventListener("click", locate);
        document
          .getElementById("use-location")
          .addEventListener("click", locate);

        // The server lets explicit lat/lng win over q. When the user edits
        // the prefilled origin text, drop the hidden coordinates so their
        // address is geocoded instead of being silently ignored.
        if (hiddenLat && hiddenLng) {
          var initial = input.value;
          form.addEventListener("submit", function () {
            if (input.value !== initial) {
              hiddenLat.remove();
              hiddenLng.remove();
            }
          });
        }
      })();
    </script>
  </body>
</html>
